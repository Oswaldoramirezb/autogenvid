# ====================================================
# VideoBot AI — Frontend Variables de Entorno
# Copia este archivo como .env.local y rellena los valores
# Las variables DEBEN empezar con VITE_ para ser expuestas al cliente
# NUNCA commitees .env.local al repositorio
# ====================================================

# ── API Gateway ──────────────────────────────────────
VITE_API_GATEWAY_URL=https://xxxx.execute-api.us-east-1.amazonaws.com/prod

# ── Cognito ──────────────────────────────────────────
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=videobot-ai.auth.us-east-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=https://xxxx.cloudfront.net
VITE_AWS_REGION=us-east-1

# ── Mock (true = sin llamadas reales, false = APIs reales) ──
VITE_USE_MOCK=true
