# ====================================================
# VideoBot AI — Backoffice Variables de Entorno
# Copia este archivo como .env y rellena los valores
# NUNCA commitees el .env al repositorio
# ====================================================

# ── AWS ─────────────────────────────────────────────
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=videos
S3_VIDEOS_BUCKET=videobot-videos-prod
S3_FRONTEND_BUCKET=videobot-frontend-prod

# ── Mock (true = usa datos fijos, false = APIs reales) ──
USE_MOCK=true

# ── ElevenLabs (voz clonada) ─────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# ── Gemini AI (generación de guiones) ──────────────────────
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-pro
