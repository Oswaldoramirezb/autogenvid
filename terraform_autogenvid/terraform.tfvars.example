# ================================================
# terraform.tfvars.example — Copia como terraform.tfvars
# NUNCA commitees terraform.tfvars al repositorio
# ================================================

aws_region   = "us-east-1"
aws_profile  = "default"
project_name = "videobot"
environment  = "prod"

# ── Modo mock (true = sin APIs reales) ────────────
use_mock     = true

# ── Claves de APIs (rellenar cuando use_mock = false) ──
elevenlabs_api_key   = "your_elevenlabs_api_key_here"
gemini_api_key       = "your_gemini_api_key_here"
pexels_api_key       = "your_pexels_api_key_here"
unsplash_access_key  = "your_unsplash_access_key_here"
